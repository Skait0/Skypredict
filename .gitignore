node_modules/
.vercel/
.DS_Store
# Scratch space - the inline-script syntax check and anything else
# temporary. tmp/blk0.js and tmp/blk1.js were tracked by accident.
tmp/

# Generated by scripts/prebuild.js at deploy time. index.html is split into
# these on a fresh checkout; the whole file stays the source of truth in git.
public/app.*.css
public/app.*.js
public/predictions.json

# Generated by scripts/prebuild.js from predictions.json. Match pages are
# build output, not source - regenerated on every deploy.
public/m/
public/sitemap.xml
public/robots.txt

# The standing pages, likewise. They carry the build date and the
# training-set size, so a committed copy would go stale and then be
# served in place of the fresh one.
public/privacy.html
public/terms.html
public/how-it-works.html
public/matches.html
public/404.html

.vercel
.env*
live.html

# Scratch dumps from poking the Vercel API while debugging. They are build
# event logs - no secrets, just noise that does not belong in the repo.
ev*.json
