{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/predictions.js": {
      "maxDuration": 10,
      "memory": 512,
      "includeFiles": "public/predictions.json"
    },
    "api/cron.js": {
      "maxDuration": 300,
      "memory": 1024
    },
    "api/live.js": {
      "maxDuration": 15,
      "memory": 256
    },
    "api/record-sweep.js": {
      "maxDuration": 30,
      "memory": 512
    },
    "api/fixtures.js": {
      "maxDuration": 15,
      "memory": 256
    },
    "api/bet9ja.js": {
      "maxDuration": 15,
      "memory": 256
    },
    "api/betking.js": {
      "maxDuration": 15,
      "memory": 256
    },
    "api/betpawa.js": {
      "maxDuration": 15,
      "memory": 256
    },
    "api/s.js": {
      "maxDuration": 10,
      "memory": 256
    },
    "api/slipcard.js": {
      "maxDuration": 15,
      "memory": 1024,
      "includeFiles": "assets/**"
    },
    "api/share.js": {
      "maxDuration": 10,
      "memory": 256
    },
    "api/push.js": {
      "maxDuration": 10,
      "memory": 256
    },
    "api/tg.js": {
      "maxDuration": 60,
      "memory": 256
    },
    "api/tgfollow.js": {
      "maxDuration": 60,
      "memory": 256
    },
    "api/social.js": {
      "maxDuration": 120,
      "memory": 256
    },
    "api/bigodds.js": {
      "maxDuration": 10,
      "memory": 128
    },
    "api/results.js": {
      "maxDuration": 10,
      "memory": 128
    },
    "api/auth.js": {
      "maxDuration": 10,
      "memory": 256
    },
    "api/me.js": {
      "maxDuration": 10,
      "memory": 256
    },
    "api/account.js": {
      "maxDuration": 10,
      "memory": 256
    }
  },
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/tgfollow",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/social",
      "schedule": "5 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/app.(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/intro-(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, s-maxage=2592000"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/predictions.json",
      "headers": [
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "public, s-maxage=1800, stale-while-revalidate=1800"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, s-maxage=300, stale-while-revalidate=600"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/m/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "skypredict-theta.vercel.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy-Report-Only", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://browser.sentry-cdn.com https://challenges.cloudflare.com https://va.vercel-scripts.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob:; connect-src 'self' https://*.ingest.de.sentry.io https://*.ingest.sentry.io; frame-src https://challenges.cloudflare.com; form-action 'self' https://accounts.google.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; report-uri https://o4511967072026624.ingest.de.sentry.io/api/4511972150673488/security/?sentry_key=ac93e87be549b605d84d8064217ccd7a" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/s",
      "destination": "/api/s"
    },
    {
      "source": "/s/:code",
      "destination": "/api/s"
    },
    {
      "source": "/slipcard.png",
      "destination": "/api/slipcard"
    },
    {
      "source": "/api/auth/:path*",
      "destination": "/api/auth?route=:path*"
    },
    {
      "source": "/api/account/:action",
      "destination": "/api/account?action=:action"
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
