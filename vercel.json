{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/predictions.js": {
      "maxDuration": 10,
      "memory": 512,
      "includeFiles": "public/predictions.json"
    },
    "api/cron.js": {
      "maxDuration": 300,
      "memory": 1024
    },
    "api/live.js": {
      "maxDuration": 15,
      "memory": 256
    },
    "api/record-sweep.js": {
      "maxDuration": 30,
      "memory": 512
    },
    "api/fixtures.js": {
      "maxDuration": 15,
      "memory": 256
    },
    "api/bet9ja.js": {
      "maxDuration": 15,
      "memory": 256
    },
    "api/betking.js": {
      "maxDuration": 15,
      "memory": 256
    },
    "api/betpawa.js": {
      "maxDuration": 15,
      "memory": 256
    },
    "api/s.js": {
      "maxDuration": 10,
      "memory": 256
    },
    "api/slipcard.js": {
      "maxDuration": 15,
      "memory": 1024,
      "includeFiles": "assets/**"
    },
    "api/share.js": {
      "maxDuration": 10,
      "memory": 256
    },
    "api/push.js": {
      "maxDuration": 10,
      "memory": 256
    },
    "api/tg.js": {
      "maxDuration": 60,
      "memory": 256
    },
    "api/tgfollow.js": {
      "maxDuration": 60,
      "memory": 256
    }
  },
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/tgfollow",
      "schedule": "*/10 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/app.(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/intro-(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, s-maxage=2592000"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/predictions.json",
      "headers": [
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "public, s-maxage=1800, stale-while-revalidate=1800"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, s-maxage=300, stale-while-revalidate=600"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/m/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "skypredict-theta.vercel.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/s",
      "destination": "/api/s"
    },
    {
      "source": "/s/:code",
      "destination": "/api/s"
    },
    {
      "source": "/slipcard.png",
      "destination": "/api/slipcard"
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
